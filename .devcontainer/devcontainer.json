{
  "name": "IsaacSim ROS2 DevContainer",

  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "isaac-sim",
  "workspaceFolder": "/workspace",

  "shutdownAction": "stopCompose",

  "overrideCommand": false,

  "remoteUser": "developer",

  "features": {},

  "runArgs": [
    "--gpus=all"
  ],

  "containerEnv": {
    "ACCEPT_EULA": "Y",
    "PRIVACY_CONSENT": "Y",
    "ROS_DISTRO": "humble",
    "OMNIVERSE_DIR": "/opt/isaac-sim"
  },

  "extensions": [
    "ms-iot.vscode-ros",
    "ms-python.python",
    "ms-vscode.cpptools",
    "ms-vscode.cmake-tools"
  ],

  "postStartCommand": "bash -lc 'source /opt/ros/humble/setup.bash; source /workspace/ros2_ws/install/setup.bash'"
}
